<Window x:Class="ProcessExplorer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProcessExplorer"
        xmlns:vm="clr-namespace:ProcessExplorer.ViewModels"
        Title="Process Explorer - Masterprocess"
        Height="800"
        Width="1200"
        Background="#2E3440"
        Foreground="White"
        Icon="/Resources/icon.ico">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar with Metrics -->
        <Border Grid.Row="0" Background="#3B4252" Padding="12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="System CPU:" Foreground="White" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding SystemCpuUsage, StringFormat=0.00}" Foreground="#A3BE8C" Margin="0,0,24,0" FontWeight="Bold"/>

                <TextBlock Text="Total Memory:" Foreground="White" Margin="0,0,8,0"/>
                <TextBlock x:Name="TotalMemoryDisplay" Foreground="#5E81AC" Margin="0,0,24,0" FontWeight="Bold"/>

                <TextBlock Text="Available:" Foreground="White" Margin="0,0,8,0"/>
                <TextBlock x:Name="AvailableMemoryDisplay" Foreground="#EBCB8B" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Control Buttons -->
        <Border Grid.Row="1" Background="#3B4252" Padding="12">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding StartMonitoringCommand}"
                        Content="Start Monitoring"
                        Padding="12,8" Margin="0,0,8,0"
                        Background="#A3BE8C"/>
                <Button Command="{Binding StopMonitoringCommand}"
                        Content="Stop Monitoring"
                        Padding="12,8" Margin="0,0,8,0"
                        Background="#BF616A"/>
                <Button Command="{Binding RefreshProcessListCommand}"
                        Content="Refresh"
                        Padding="12,8"
                        Background="#5E81AC"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Process List -->
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Processes}"
                      SelectedItem="{Binding SelectedProcess}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Background="#3B4252"
                      Foreground="White"
                      BorderBrush="#434C5E"
                      RowBackground="#3B4252"
                      AlternatingRowBackground="#434C5E">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80"/>
                    <DataGridTextColumn Header="Memory" Binding="{Binding MemoryFormatted}" Width="100"/>
                    <DataGridTextColumn Header="CPU %" Binding="{Binding CpuUsageFormatted}" Width="80"/>
                    <DataGridTextColumn Header="Threads" Binding="{Binding ThreadCount}" Width="70"/>
                    <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime, StringFormat='{0:HH:mm:ss}'}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Details Panel -->
            <Border Grid.Column="1" Background="#3B4252" Padding="12" Margin="4,0,0,0">
                <StackPanel>
                    <TextBlock Text="Process Details" FontSize="14" FontWeight="Bold" Foreground="#5E81AC" Margin="0,0,0,12"/>

                    <TextBlock Text="Name:" Foreground="#D8DEE9"/>
                    <TextBlock Text="{Binding SelectedProcess.Name}" Foreground="#A3BE8C" Margin="0,0,0,8"/>

                    <TextBlock Text="PID:" Foreground="#D8DEE9"/>
                    <TextBlock Text="{Binding SelectedProcess.ProcessId}" Foreground="#A3BE8C" Margin="0,0,0,8"/>

                    <TextBlock Text="Memory:" Foreground="#D8DEE9"/>
                    <TextBlock Text="{Binding SelectedProcess.MemoryFormatted}" Foreground="#A3BE8C" Margin="0,0,0,8"/>

                    <TextBlock Text="CPU Usage:" Foreground="#D8DEE9"/>
                    <TextBlock Text="{Binding SelectedProcess.CpuUsageFormatted}" Foreground="#A3BE8C" Margin="0,0,0,8"/>

                    <TextBlock Text="GPU Memory:" Foreground="#D8DEE9"/>
                    <TextBlock Text="{Binding SelectedProcess.GpuMemoryFormatted}" Foreground="#A3BE8C" Margin="0,0,0,8"/>

                    <TextBlock Text="Threads:" Foreground="#D8DEE9"/>
                    <TextBlock Text="{Binding SelectedProcess.ThreadCount}" Foreground="#A3BE8C" Margin="0,0,0,8"/>

                    <TextBlock Text="Window:" Foreground="#D8DEE9"/>
                    <TextBlock Text="{Binding SelectedProcess.WindowTitle}" Foreground="#A3BE8C" Margin="0,0,0,8" TextWrapping="Wrap"/>

                    <TextBlock Text="Path:" Foreground="#D8DEE9" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding SelectedProcess.Path}" Foreground="#A3BE8C" TextWrapping="Wrap" FontSize="10"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#3B4252" Foreground="White">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding IsMonitoring, StringFormat='Monitoring: {0}'}" Foreground="#A3BE8C"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
